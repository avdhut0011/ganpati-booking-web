# =========================================================
# 🌺 GANPATI BOOKING SYSTEM - PRODUCTION ENVIRONMENT (.env)
# =========================================================

# Database Configuration (SQLite on EBS or PostgreSQL on RDS)
DATABASE_URL=sqlite:///./ganpati.db
# For AWS RDS PostgreSQL: postgresql://dbuser:StrongPassword@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/ganpatidb

# Security & JWT Token Authentication
JWT_SECRET=generate-a-64-character-random-hex-string-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Replace with your custom domain or CloudFront URL)
CORS_ORIGINS=["https://booking.yourstall.com", "https://d111111abcdef8.cloudfront.net"]

# Gemini AI Engine Key
GEMINI_API_KEY=your_gemini_api_key_here

# =========================================================
# AWS S3 Cloud Storage & CloudFront (Optional - Free Tier)
# =========================================================
USE_CLOUD_STORAGE=false
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_CLOUDFRONT_DOMAIN=your_cloudfront_domain_here
